menu "TH sensor application"

    config APP_MEASURE_INTERVAL_S
        int "Default measurement interval (s)"
        range 10 3600
        default 60
        help
            SHT40 sampling period. Matter reporting is decided by the subscriber
            (min/max interval) and the ICD state machine, not by this value.

    config APP_BATTERY_INTERVAL_S
        int "Default battery measurement interval (s)"
        range 600 86400
        default 21600

    config APP_MANUAL_MEASURE_MIN_INTERVAL_MS
        int "Minimum time between button-triggered measurements (ms)"
        range 1000 60000
        default 5000

    config APP_TEMP_DEADBAND_CENTI
        int "Temperature publish deadband (0.01 degC)"
        range 0 200
        default 10

    config APP_RH_DEADBAND_CENTI
        int "Humidity publish deadband (0.01 %RH)"
        range 0 1000
        default 100

    config APP_SENSOR_FAIL_THRESHOLD
        int "Consecutive sensor failures before publishing null"
        range 1 20
        default 3

    config APP_SENSOR_RETRY_MIN_MS
        int "First retry delay after a failed measurement (ms)"
        range 500 60000
        default 2000

    config APP_HEATER_HOLDOFF_S
        int "Publishing hold-off after a maintenance heater pulse (s)"
        range 30 1800
        default 120

    config APP_COMMISSIONING_WINDOW_S
        int "Commissioning window opened by the button (s)"
        range 180 900
        default 180

    config APP_LED_DEFAULT_ENABLED
        bool "LED feedback enabled by default"
        default y

    config APP_THREAD_TX_POWER_DBM
        int "Default 802.15.4 TX power (dBm)"
        range -24 8
        default 5
        help
            Upper limit +8 dBm is set by the coin-cell power path (one
            TPS63900 with a 100 mA input current limit), see
            docs/power_budget.md. Tune downwards only after a link-budget test.

    config APP_BAT_CELL_PRESENT_MV
        int "Cell counted as present above this voltage (mV)"
        range 500 2500
        default 1500
        help
            An empty holder reads ~0 V through the switched divider. Rev B has
            no other supply, so a reading below this while running points to a
            sense-path fault (R31/R32, Q3, GPIO5) and reports Critical.

    config APP_BAT_WARN_PCT
        int "Pack charge below which BatChargeLevel = Warning (%)"
        range 5 80
        default 40
        help
            ESTIMATE: the power model (docs/power_budget.md) predicts that
            reports start to fail once about half of the CR2450's nominal
            capacity is used (internal resistance, not voltage, ends the cell's
            life), i.e. well before the capacity is used up.

    config APP_BAT_CRIT_PCT
        int "Pack charge below which BatChargeLevel = Critical (%)"
        range 1 60
        default 20

    config APP_POWER_GUARD_ENABLE
        bool "Brown-out / low-battery boot guard"
        default y

    config APP_BOOT_MIN_CELL_MV
        int "Minimum cell voltage to start the radio (mV)"
        depends on APP_POWER_GUARD_ENABLE
        range 1700 3000
        default 2400

    config APP_GUARD_RECOVERY_MV
        int "Cell voltage rise that counts as a new cell (mV)"
        depends on APP_POWER_GUARD_ENABLE
        range 50 1000
        default 150
        help
            After repeated unstable boots the guard backs off with deep sleep.
            A boot whose cell voltage is this much higher than at the last
            unstable boot is treated as a battery change and clears the backoff.

    config APP_GUARD_BACKOFF_MIN_S
        int "First guard deep-sleep period (s)"
        depends on APP_POWER_GUARD_ENABLE
        range 30 3600
        default 300

    config APP_GUARD_BACKOFF_MAX_S
        int "Maximum guard deep-sleep period (s)"
        depends on APP_POWER_GUARD_ENABLE
        range 300 86400
        default 14400

    config APP_STABLE_AFTER_S
        int "Uptime after which a boot counts as stable (s)"
        range 60 86400
        default 600

    config APP_CONSOLE_ENABLE
        bool "Maintenance console"
        default y

endmenu
